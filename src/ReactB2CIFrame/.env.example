# Environment variables for Azure B2C Configuration
# Copy this file to .env.local and update with your Azure B2C values

REACT_APP_B2C_CLIENT_ID=your-client-id-here
REACT_APP_B2C_TENANT_NAME=your-tenant-name
REACT_APP_B2C_POLICY_SIGNIN=B2C_1_SignUpSignIn
REACT_APP_B2C_POLICY_RESET=B2C_1_PasswordReset
REACT_APP_B2C_POLICY_EDIT=B2C_1_ProfileEdit
